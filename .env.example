# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不要提交到仓库。
# 绝不要把真实密码写进源码或提交到版本库。

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=manage_agent

# 可选：给一整串连接串会覆盖上面的分项配置
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/manage_agent

# SiliconFlow API Key，用于拉取模型列表和调用对话接口
SILICONFLOW_API_KEY=your_siliconflow_api_key
